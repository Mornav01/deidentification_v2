# ════════════════════════════════════════════════════════════════════════════
# deidentification_v2 — environment template
#
# The deid CLI itself is configured via config.yaml (with ${VAR} interpolation).
# The variables below are read directly via os.environ by the CDC/MySQL scripts
# and a few helpers. When the CDC pipeline runs under Airflow (DEID_REPO_DIR),
# these are inherited from the Airflow worker's .env — keep the two in sync.
# ════════════════════════════════════════════════════════════════════════════

# ── Local / destination MySQL (CDC restore target, mapping/master, validation) ──
DB_HOST=<mysql_host>
MYSQL_PORT=3306
DB_USER=<mysql_user>
DB_PASS=<mysql_password>

# ── Source MySQL for dump_and_restore.py / id_validation.py (remote, read-only) ──
SRC_DB_HOST=<source_mysql_host>
SRC_DB_PORT=4928
SRC_DB_USER=<source_readonly_user>
SRC_DB_PASS=<source_readonly_password>
SRC_DB_SCHEMA=mobiledoc
# Destination schema for the restored dump (dump_and_restore.py)
DST_DB_SCHEMA=mobiledoc

# ── MSSQL SA auth (used only if any CDC step shells into sqlcmd) ──
SA_USER=sa
SA_PASS=<mssql_sa_password>
